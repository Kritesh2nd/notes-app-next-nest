pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
        jdk 'JDK-17'
    }

    parameters {
        booleanParam(
            name: 'PUSH_DOCKER_IMAGE',
            defaultValue: false,
            description: 'Build and push the Docker image after a successful Maven build'
        )

        booleanParam(
            name: 'DEPLOY',
            defaultValue: false,
            description: 'Deploy the Docker image to the Jenkins agent server'
        )

        string(
            name: 'DOCKER_IMAGE_NAME_FRONTEND',
            defaultValue: 'moudle8848/noteapp-next',
            description: 'Docker image repository without tag, e.g. moudle8848/noteapp-next'
        )

        string(
            name: 'DOCKER_IMAGE_NAME_BACKEND',
            defaultValue: 'moudle8848/noteapp-nest',
            description: 'Docker image repository without tag, e.g. moudle8848/noteapp-nest'
        )

        string(
            name: 'DEPLOY_SERVER_IP',
            defaultValue: '',
            description: 'Private IP address of the deployment EC2 server'
        )
    }


    environment {
        DOCKER_CREDENTIALS_ID = 'docker_credentials'

        DEPLOY_DIR = '/opt/noteapp'

        IMAGE_TAG_FRONTEND = "${params.DOCKER_IMAGE_NAME_FRONTEND}:${env.BUILD_NUMBER}"

        IMAGE_TAG_BACKEND = "${params.DOCKER_IMAGE_NAME_BACKEND}:${env.BUILD_NUMBER}"
    }

    options {
        timestamps()

        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        skipDefaultCheckout(false)
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def changes = sh(
                        script: "git diff --name-only HEAD~1 HEAD",
                        returnStdout: true
                    ).trim()

                    env.FRONTEND_CHANGED = changes.split('\n').any {
                        it.startsWith('frontend/')
                    } ? 'true' : 'false'

                    env.BACKEND_CHANGED = changes.split('\n').any {
                        it.startsWith('backend/')
                    } ? 'true' : 'false'
                    }
                }
            }
        }

        stage('Build Frontend') {
            when {
                expression {
                    env.FRONTEND_CHANGED == 'true'
                }
            }
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Build Backend') {
            when {
                expression {
                    env.BACKEND_CHANGED == 'true'
                }
            }
            steps {
                dir('backend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Test Backend') {
            when {
                expression {
                    env.BACKEND_CHANGED == 'true'
                }
            }
            steps {
                dir('backend') {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Running Backend Tests"
                        echo "======================================"

                        npm ci
                        npm test
                    '''
                }
            }

            post {
                always {
                    junit(
                        testResults: 'backend/test-results/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Package') {
            steps {
                script {

                    if (env.FRONTEND_CHANGED == 'true') {
                        dir('frontend') {
                            sh '''
                                set -e

                                echo "======================================"
                                echo "Building Frontend"
                                echo "======================================"

                                npm ci
                                npm run build
                            '''
                        }
                    }

                    if (env.BACKEND_CHANGED == 'true') {
                        dir('backend') {
                            sh '''
                                set -e

                                echo "======================================"
                                echo "Building NestJS Backend"
                                echo "======================================"

                                npm ci
                                npm run build
                            '''
                        }
                    }
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'frontend/dist/**,backend/dist/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    return params.PUSH_DOCKER_IMAGE
                }
            }

            steps {
                script {

                    if (env.FRONTEND_CHANGED == 'true') {
                        echo "======================================"
                        echo "Building Frontend Docker Image"
                        echo "======================================"

                        sh '''
                            set -e

                            echo "Docker version:"
                            docker --version

                            echo "Building frontend image:"
                            echo "$IMAGE_TAG_FRONTEND"

                            docker build -t "$IMAGE_TAG_FRONTEND" ./frontend

                            echo "Frontend Docker image built successfully."
                        '''
                    }

                    if (env.BACKEND_CHANGED == 'true') {
                        echo "======================================"
                        echo "Building Backend Docker Image"
                        echo "======================================"

                        sh '''
                            set -e

                            echo "Docker version:"
                            docker --version

                            echo "Building backend image:"
                            echo "$IMAGE_TAG_BACKEND"

                            docker build -t "$IMAGE_TAG_BACKEND" ./backend

                            echo "Backend Docker image built successfully."
                        '''
                    }
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    return params.PUSH_DOCKER_IMAGE
                }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS_ID}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Docker Login"
                        echo "======================================"

                        printf '%s' "$DOCKER_PASS" | docker login \
                            --username "$DOCKER_USER" \
                            --password-stdin

                        echo ""
                        echo "Docker login successful."

                        if [ "$FRONTEND_CHANGED" = "true" ]; then
                            echo ""
                            echo "======================================"
                            echo "Pushing Frontend Image"
                            echo "======================================"

                            echo "Pushing image:"
                            echo "$FRONTEND_IMAGE_TAG"

                            docker push "$FRONTEND_IMAGE_TAG"

                            echo "Frontend image pushed successfully."
                        fi

                        if [ "$BACKEND_CHANGED" = "true" ]; then
                            echo ""
                            echo "======================================"
                            echo "Pushing Backend Image"
                            echo "======================================"

                            echo "Pushing image:"
                            echo "$BACKEND_IMAGE_TAG"

                            docker push "$BACKEND_IMAGE_TAG"

                            echo "Backend image pushed successfully."
                        fi

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy') {
        when {
            expression {
                return params.DEPLOY &&
                    (env.FRONTEND_CHANGED == 'true' ||
                        env.BACKEND_CHANGED == 'true')
            }
        }

        steps {
            withCredentials([
                usernamePassword(
                    credentialsId: "${DOCKER_CREDENTIALS_ID}",
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                ),
                sshUserPrivateKey(
                    credentialsId: 'deploye_server_credentials',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USER'
                )
            ]) {

                sh '''
                    set -e

                    DEPLOY_HOST="$DEPLOY_SERVER_IP"
                    DEPLOY_DIR="/opt/noteapp"

                    echo "======================================"
                    echo "Deploy"
                    echo "======================================"

                    echo "Deployment server: $DEPLOY_HOST"

                    echo ""
                    echo "Testing SSH connection..."

                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$DEPLOY_HOST" hostname


                    echo ""
                    echo "======================================"
                    echo "Preparing Deployment Directory"
                    echo "======================================"

                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$DEPLOY_HOST" \
                        "sudo mkdir -p $DEPLOY_DIR"


                    echo ""
                    echo "======================================"
                    echo "Copying Compose File"
                    echo "======================================"

                    scp -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        docker-compose.prod.yml \
                        "$SSH_USER@$DEPLOY_HOST:/tmp/docker-compose.yml"

                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$DEPLOY_HOST" \
                        "sudo mv /tmp/docker-compose.yml $DEPLOY_DIR/docker-compose.yml"


                    echo ""
                    echo "======================================"
                    echo "Docker Login"
                    echo "======================================"

                    printf '%s' "$DOCKER_PASS" | ssh \
                        -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$DEPLOY_HOST" \
                        "docker login \
                            --username '$DOCKER_USER' \
                            --password-stdin"


                    echo ""
                    echo "======================================"
                    echo "Deploying Changed Services"
                    echo "======================================"

                    if [ "$FRONTEND_CHANGED" = "true" ]; then

                        echo ""
                        echo "Frontend changed."
                        echo "Image: $FRONTEND_IMAGE_TAG"

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_HOST" \
                            "cd $DEPLOY_DIR && \
                            export FRONTEND_IMAGE_TAG='$FRONTEND_IMAGE_TAG' && \
                            docker compose pull frontend && \
                            docker compose up -d frontend"

                        echo "Frontend deployed successfully."
                    fi


                    if [ "$BACKEND_CHANGED" = "true" ]; then

                        echo ""
                        echo "Backend changed."
                        echo "Image: $BACKEND_IMAGE_TAG"

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_HOST" \
                            "cd $DEPLOY_DIR && \
                            export BACKEND_IMAGE_TAG='$BACKEND_IMAGE_TAG' && \
                            docker compose pull backend && \
                            docker compose up -d backend"

                        echo "Backend deployed successfully."
                    fi


                    echo ""
                    echo "======================================"
                    echo "Container Status"
                    echo "======================================"

                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$DEPLOY_HOST" \
                        "cd $DEPLOY_DIR && docker compose ps"


                    echo ""
                    echo "======================================"
                    echo "Cleaning Docker Images"
                    echo "======================================"

                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$DEPLOY_HOST" \
                        "docker image prune -f"


                    echo ""
                    echo "======================================"
                    echo "Docker Logout"
                    echo "======================================"

                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$DEPLOY_HOST" \
                        "docker logout || true"


                    echo ""
                    echo "======================================"
                    echo "Deployment Successful"
                    echo "======================================"
                '''
            }
        }
    }

    post {
        success {
            echo "Build #${env.BUILD_NUMBER} succeeded."
        }

        failure {
            echo "Build #${env.BUILD_NUMBER} failed. Check the stage logs above."
        }

        always {
            cleanWs()
        }
    }
}