# Server
PORT=4000
NODE_ENV=development

# Logging verbosity: error | warn | info | debug (see backend/README.md#logging)
LOG_LEVEL=info

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blueprint_notes?schema=public"

# JWT — MUST match the frontend's JWT_SECRET if the frontend middleware
# needs to read/verify this cookie itself.
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — the frontend origin allowed to call this API with credentials
FRONTEND_URL="http://localhost:3000"

# Used to build links inside verification / reset emails (points at the frontend)
APP_URL="http://localhost:3000"
APP_NAME="Blueprint Notes"

# SMTP (transactional email). Leave blank in dev to log emails to the console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Blueprint Notes <no-reply@blueprint-notes.dev>"

# ---------------------------------------------------------------------------
# Admin bootstrap — on every startup, the backend ensures exactly one admin
# account exists with these credentials (creates it if missing, or promotes
# an existing user with this email to ADMIN). Change the password after
# first login for production use.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@blueprint-notes.dev"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Site Admin"
